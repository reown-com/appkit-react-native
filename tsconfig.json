{
  "compilerOptions": {
    "allowJs": false,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noImplicitUseStrict": false,
    "noStrictGenericChecks": false,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "verbatimModuleSyntax": true,
    "paths": {
      // apps/native imports a bitcoinjs-lib subpath that is only exposed through package.json
      // "exports", which "moduleResolution": "node" does not read. Map it to its CJS typings.
      "bitcoinjs-lib/src/*": ["./apps/native/node_modules/bitcoinjs-lib/src/cjs/*"]
    }
  },
  "exclude": ["node_modules", "dist", "types", "lib", "build", "examples", "**/jest.config.ts"]
}
